# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/cricket_eco
# Render/Heroku-style managed Postgres usually needs SSL:
DATABASE_SSL=false

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
COOKIE_SECURE=false
# hours
JWT_EXPIRES_HOURS=168

# --- First admin account (auto-created on boot if no admin exists yet) ---
ADMIN_EMAIL=admin@cricketeco.example
ADMIN_PASSWORD=change-this-immediately

# --- Outbound email (SMTP) ---
# If left blank, emails are logged to the console/DB instead of sent -
# safe default for local dev, fill in real SMTP creds before going live.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cricket ECO Solutions <admin@cricketeco.example>"

# --- App ---
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# comma-separated allowed origins for CORS if the frontend is hosted separately
CORS_ORIGIN=*
# score (0-100) at/above which a request is marked ready instead of not ready
DEFAULT_PASS_THRESHOLD=70
# max upload size in MB for discovery documents
MAX_UPLOAD_MB=8
